div>\n            <button class=\"carousel-control-prev\" type=\"button\" data-bs-target=\"#galeriaCarrusel6\" data-bs-slide=\"prev\">\n              <span class=\"carousel-control-prev-icon\"></span>\n            </button>\n            <button class=\"carousel-control-next\" type=\"button\" data-bs-target=\"#galeriaCarrusel6\" data-bs-slide=\"next\">\n              <span class=\"carousel-control-next-icon\"></span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n          <!-- Modal 7 -->\n  <div class=\"modal fade\" id=\"galeriaModal7\" tabindex=\"-1\" aria-labelledby=\"galeriaModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-lg modal-dialog-centered\">\n      <div class=\"modal-content bg-dark text-white\">\n        <div class=\"modal-header\">\n          <button type=\"button\" class=\"btn-close btn-close-white\" data-bs-dismiss=\"modal\" aria-label=\"Cerrar\"></button>\n        </div>\n        <div class=\"modal-body\">\n          <div id=\"galeriaCarrusel7\" class=\"carousel slide\" data-bs-ride=\"carousel\">\n            <div class=\"carousel-inner\">\n              \n              \n              <div class=\"carousel-item active\">\n                <img src=\"@PROJECT_PATH@/assets/images/swagerboys1.jpg\" class=\"d-block w-100\" alt=\"Imagen 1\">\n              </div>\n                <div class=\"carousel-item\">\n                <img src=\"@PROJECT_PATH@/assets/images/swagerboys2.jpg\" class=\"d-block w-100\" alt=\"Imagen 2\">\n              </div>\n                <div class=\"carousel-item\">\n                <img src=\"@PROJECT_PATH@/assets/images/swagerboys3.jpg\" class=\"d-block w-100\" alt=\"Imagen 3\">\n              </div>\n                <div class=\"carousel-item\">\n                <img src=\"@PROJECT_PATH@/assets/images/swagerboys4.jpg\" class=\"d-block w-100\" alt=\"Imagen 4\">\n              </div>\n                <div class=\"carousel-item\">\n                <img src=\"@