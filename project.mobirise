              }
            },
            "button.btn_offcanvas": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "50px",
              "height": "50px",
              "border-radius": "50%",
              "margin-right": "15px",
              "transition": "all 0.3s",
              "background": "linear-gradient(145deg, @hamburgerBg1, @hamburgerBg2)",
              "& when (@hamburgerShadow)": {
                "box-shadow": "10px 10px 19px @hamburgerColor1, -10px -10px 19px @hamburgerColor1"
              },
              "outline": "none",
              "border": "none",
              "cursor": "pointer",
              "position": "relative",
              "align-self": "center",
              "&:hover": {
                "transform": "scale(1.1)"
              },
              ".hamburger-offcanvas": {
                "position": "relative",
                "width": "23px",
                "height": "24px",
                "transition": "all 0.3s"
              },
              ".hamburger-offcanvas span": {
                "position": "absolute",
                "right": "2px",
                "width": "20px",
                "height": "2px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "6px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "11px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "11px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            ".btn-close": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "50px",
              "height": "50px",
              "border-radius": "50%",
              "margin-left": "15px",
              "transition": "all 0.3s",
              "opacity": "1 !important",
              "background": "linear-gradient(145deg, @hamburgerBg1, @hamburgerBg2)",
              "& when (@hamburgerShadow)": {
                "box-shadow": "10px 10px 19px @hamburgerColor1, -10px -10px 19px @hamburgerColor2"
              },
              "outline": "none",
              "border": "none",
              "cursor": "pointer",
              "position": "relative",
              "align-self": "center",
              "&:hover": {
                "transform": "scale(1.1)",
                "opacity": "1 !important"
              },
              ".hamburger-offcanvas": {
                "position": "relative",
                "width": "23px",
                "height": "24px",
                "transition": "all 0.3s"
              },
              ".hamburger-offcanvas span": {
                "position": "absolute",
                "right": "2px",
                "width": "20px",
                "height": "2px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "display": "none"
                },
                "&:nth-child(2)": {
                  "top": "11px",
                  "transform": "rotate(45deg)",
                  "transition": "all 0.25s"
                },
                "&:nth-child(3)": {
                  "top": "11px",
                  "transform": "rotate(-45deg)",
                  "transition": "all 0.25s"
                },
                "&:nth-child(4)": {
                  "display": "none"
                }
              }
            },
            ".offcanvas-end": {
              "left": "0 !important",
              "transform": "translateX(-100%)"
            },
            ".offcanvas.show": {
              "transform": "translateX(0)"
            },
            ".offcanvas": {
              "padding": "0",
              "width": "100%",
              "border-left": "none !important",
              "background-color": "transparent !important",
              "transition": "transform 0.5s ease-in-out"
            },
            ".offcanvas_box": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center"
            },
            ".offcanvas-body": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "padding": "25px",
              "width": "375px",
              "margin-right": "auto",
              "text-align": "left",
              "background-color": "@offcanvasColor",
              "box-shadow": "0 0 10px 0 rgba(0, 0, 0, 0.7)",
              "@media (max-width: 575px)": {
                "width": "260px",
                "padding": "10px"
              },
              ".offcanvas_head": {
                "width": "100%",
                "border-bottom": "1px solid rgba(255, 255, 255, 0.1)",
                "padding-bottom": "20px"
              },
              ".offcanvas_head_container": {
                "display": "flex",
                "align-items": "center",
                "justify-content": "space-between"
              },
              ".navbar-brand": {
                "min-height": "70px",
                "padding": "0 !important",
                ".navbar-logo": {
                  "@media (max-width: 575px)": {
                    "margin-right": "0.5rem"
                  }
                },
                "img": {
                  "height": "70px !important",
                  "@media (max-width: 575px)": {
                    "height": "60px !important"
                  }
                }
              }
            },
            ".mbr-text": {
              "color": "#878e99",
              "margin-top": "20px",
              "padding-right": "7%"
            },
            ".modal-backdrop.show": {
              "opacity": "0.8"
            },
            ".offcanvas_link": {
              "width": "100%",
              "overflow": "auto",
              "padding": "0",
              "margin-top": "20px"
            },
            "::-webkit-scrollbar": {
              "width": "1em"
            },
            "::-webkit-scrollbar-track": {
              "background-color": "#232323"
            },
            "::-webkit-scrollbar-thumb": {
              "background-color": "#535B6D",
              "border-radius": "1em"
            },
            ".social-container": {
              "width": "100%",
              "margin-top": "auto",
              "@media (max-width: 991px)": {
                "padding-top": "40px"
              }
            },
            ".social-title": {
              "color": "#C4CFDE",
              "border-top": "1px solid rgba(255, 255, 255, 0.1)",
              "padding-top": "20px",
              "margin-top": "50px !important"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-7px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "7px",
              "min-width": "53px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "20px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                "&:before": {
                  "opacity": "1"
                }
              }
            },
            ".offcanvas_btn": {
              "margin-top": "auto",
              ".mbr-section-btn": {
                "display": "flex",
                "flex-direction": "column",
                "align-items": "stretch",
                "width": "100%",
                "margin-left": "-0.6rem",
                "margin-right": "-0.6rem",
                ".btn": {
                  "flex-grow": "1"
                }
              }
            }
          },
          "_name": "amenu2",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu2 expertm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <header>Offcanvas</header>\n        <input type=\"color\" title=\"Offcanvas Color\" name=\"offcanvasColor\" value=\"#16181c\">\n        <input type=\"checkbox\" title=\"Links\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showOffcanvasLogo\" checked>\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showOffcanvasBrand\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showOffcanvasButtons\">\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <header condition=\"showSocial\">Social</header>\n        <select title=\"Icons Align\" name=\"contentAlign\" condition=\"showSocial\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Social Title\" name=\"showSocialTitle\" checked condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#1e2024\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" condition=\"showSocial\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#212428\" condition=\"socialShadow && showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#212428\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ec1722\">\n        <input type=\"color\" title=\"Hamburger BG 1\" name=\"hamburgerBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Hamburger BG 2\" name=\"hamburgerBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"hamburgerShadow\" title=\"Hamburger Shadow\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"hamburgerColor1\" value=\"#191b1f\" condition=\"hamburgerShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"hamburgerColor2\" value=\"#23272B\" condition=\"hamburgerShadow\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div class=\"container-fluid\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    \n                        <img src=\"@PROJECT_PATH@/assets/images/logo-bien-sinfondo.png-256x256.png\" alt=\"Logo Mark\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    \n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Mark</a></span>\n            </div>\n            <div class=\"offcanvas_box\">\n                <button class=\"btn_offcanvas\" type=\"button\" data-bs-toggle=\"offcanvas\" data-bs-target=\"#offcanvasRight\" aria-controls=\"offcanvasRight\">\n                    <div class=\"hamburger-offcanvas\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n                <div class=\"offcanvas offcanvas-end\" tabindex=\"-1\" id=\"offcanvasRight\" aria-labelledby=\"offcanvasRightLabel\">\n\n                    <div class=\"offcanvas-body\">\n                        <div class=\"offcanvas_head\">\n                            <div class=\"offcanvas_head_container\">\n                                <div class=\"navbar-brand\">\n                                <span mbr-if=\"showOffcanvasLogo\" class=\"navbar-logo\">\n                                     \n                                        <img src=\"@PROJECT_PATH@/assets/images/logo-bien-sinfondo.png-140x140.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                                     \n                                </span>\n                                    <span mbr-if=\"showOffcanvasBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Marc Garcia</a></span>\n                                </div>\n                                <button type=\"button\" class=\"btn-close text-reset\" data-bs-dismiss=\"offcanvas\" aria-label=\"Close\">\n                                    <div class=\"hamburger-offcanvas\">\n                                        <span></span>\n                                        <span></span>\n                                        <span></span>\n                                        <span></span>\n                                    </div>\n                                </button>\n                            </div>\n                            <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Excepteur sint occaecat cupidatat non proident\n                            </p>\n                        </div>\n                        <div class=\"offcanvas_link\" mbr-if=\"showContacts\">\n                            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-7\"><li class=\"nav-item\">\n                                    <a class=\"nav-link link text-warning text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">LOBBY</a>\n                                </li>\n                                <li class=\"nav-item\">\n                                    <a class=\"nav-link link text-warning text-primary\" href=\"fotografias.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">FOTOGRAFIAS</a>\n                                </li>\n                                <li class=\"nav-item\">\n                                    <a class=\"nav-link link text-warning text-primary\" href=\"proyectos.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PROYECTOS</a>\n                                </li>\n                                <li class=\"nav-item\">\n                                    <a class=\"nav-link link text-warning text-primary\" href=\"contacto.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CONTACTO</a>\n                                </li></ul>\n                        </div>\n                        <div class=\"social-container\" mbr-if=\"showSocial\">\n                            <p class=\"social-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSocialTitle\" data-app-selector=\".social-title\">SIGUEME</p>\n                            <div class=\"social-list {{contentAlign}}\">\n                                <div class=\"soc-item\" mbr-if=\"socialCount>0\">\n                                    <a href=\"https://www.youtube.com/channel/UCYoQMQDC6Ts70V7mHRvmlCg\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social fa-youtube fa\"></span></a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                    <a href=\"https://www.instagram.com/maze1331_/\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social sli-social-instagram\"></span></a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                    <a href=\"index.html\"><span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span></a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                    <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                    <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                                    <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"offcanvas_btn\" mbr-if=\"showOffcanvasButtons\">\n                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn custom-section-btn\">\n                                <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    PURCHASE NOW</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "uKkvyQQV8Y",
          "_anchor": "amenu2-l",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "form01",
          "_sourceTheme": "rangem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 range5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Social Icons\" name=\"showSocialIcons\" checked>\n        <input type=\"range\" title=\"Count\" name=\"iconCount\" min=\"0\" max=\"5\" step=\"1\" value=\"2\" condition=\"showSocialIcons\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Text\" value=\"#ffffff\" name=\"text\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#1e2024\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"color\" title=\"Input Border Active\" value=\"#ec1722\" name=\"borderActive\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#23272b\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rangem5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Marc Garcia</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                            FOTÓGRAFO EDITOR Y FILMMAKER<br>\n                        </p><br>\n                        <p class=\"card-contacts mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\"></p>\n                        <p class=\"card-contacts mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                            Email:<br><a href=\"#\" class=\"text-primary\">elladohumano13@gmail.com</a>\n                        </p>\n                        <div class=\"mbr-social-likns align-left mb-0\" data-counters=\"false\" mbr-if=\"iconCount > 0 &amp;&amp; showSocialIcons\">\n                            <a class=\"iconfont-wrapper ms-0\" href=\"https://www.youtube.com/channel/UCYoQMQDC6Ts70V7mHRvmlCg\" target=\"_blank\" mbr-if=\"iconCount > 0\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-youtube socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://www.instagram.com/maze1331_/\" target=\"_blank\" mbr-if=\"iconCount > 1\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 2\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"http://eulenc.com\" target=\"_blank\" mbr-if=\"iconCount > 3\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-youtube socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper ms-3\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconCount > 4\">\n                                <span mbr-icon class=\"p-2 mbr-iconfont socicon-pinterest socicon\"></span>\n                            </a>\n                        </div>\n                    </div>\n                    <div mbr-form class=\"ms-auto mbr-form\">\n                        <!--Formbuilder Form-->\n                        <form action=\"elladohumano13@gmail.com\" name=\"range5\" method=\"POST\" class=\"mbr-form form-with-styler form-wrap\" data-verified=\"elladohumano13@gmail.com\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Gracias. Me pondre en contacto lo antes posible. </div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                    Oops...!\n                                    some problem! </div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                                    <h3 mbr-theme-style=\"display-5\" class=\"mbr-section-title mbr-fonts-style\">CONTACTAME</h3>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n                                    <input type=\"text\" name=\"text\" placeholder=\"Nombre\" data-form-field=\"text\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n                                </div>\n                                <div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"tel\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <input type=\"tel\" name=\"tel\" placeholder=\"Telefono\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                                </div>\n                                <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n                                    <textarea name=\"textarea\" placeholder=\"Mensaje\" data-form-field=\"textarea\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\"></textarea>\n                                </div>\n                                <div class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 btn btn-primary\" data-app-placeholder=\"Type Text\">Enviar</a></div>\n                            </div>\n                        </form><!--Formbuilder Form-->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 23px"
                },
                "@media (max-width: 768px)": {
                  "padding": "0 12px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 23px"
              },
              "@media (max-width: 768px)": {
                "padding": "0 12px"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "border-radius": "32px",
              "padding": "1.5rem",
              "@media (max-width: 768px)": {
                "display": "block",
                "padding": "0.5rem"
              },
              ".title-wrapper": {
                "width": "50%",
                "margin-right": "32px",
                "& when (@reverseContent)": {
                  "margin-right": "0",
                  "margin-left": "32px"
                },
                "@media (max-width: 768px)": {
                  "width": "100%",
                  "padding": "24px",
                  "margin": "0"
                },
                "@media (max-width: 576px)": {
                  "padding": "0px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "1.5rem"
                },
                ".mbr-social-likns .mbr-iconfont": {
                  "border-radius": "50px",
                  "border": "1px solid #fdfde1",
                  "color": "#fdfde1",
                  "transition": "all 300ms ease",
                  "&:hover": {
                    "color": "#bff747",
                    "border-color": "#bff747"
                  }
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                }
              },
              ".mbr-form": {
                "width": "40%",
                "@media (max-width: 992px)": {
                  "width": "50%"
                },
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                ".form-wrap": {
                  "width": "100%",
                  "@media (max-width: 768px)": {
                    "padding": "24px"
                  },
                  "@media (max-width: 576px)": {
                    "padding": "0px"
                  },
                  ".dragArea.row": {
                    ".mbr-section-title": {
                      "margin-bottom": "20px !important"
                    },
                    ".mbr-text": {
                      "margin-bottom": "20px !important"
                    },
                    ".form-group": {
                      "margin-bottom": "16px !important",
                      ".form-control": {
                        "color": "@text",
                        "padding": "1.3rem 1.5rem",
                        "font-weight": "700",
                        "box-shadow": "none",
                        "border-radius": "3rem !important",
                        "border": "1px solid @border !important",
                        "background-color": "@inputBg",
                        "transition": "all 300ms ease",
                        "&:hover, &:focus": {
                          "border": "1px solid @borderActive !important",
                          "box-shadow": "none"
                        },
                        "&::placeholder": {
                          "color": "@border"
                        }
                      },
                      "textarea.form-control": {
                        "min-height": "150px",
                        "border-radius": "1.3rem !important"
                      },
                      ".form-check": {
                        "padding-left": "1.7em",
                        "margin-bottom": "10px",
                        ".form-check-input": {
                          "background-color": "@border",
                          "border-color": "@border"
                        }
                      }
                    },
                    ".mbr-section-btn": {
                      "margin-top": "6px",
                      ".btn": {
                        "width": "100%",
                        "padding": "1.25rem 1.5rem"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-form .form-conrol": {
              "color": "@text"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#c4cfde"
            },
            "label": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            ".card-contacts": {
              "color": "#ffffff"
            }
          },
          "_cid": "uLULYxzG5c",
          "_anchor": "form01-t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
